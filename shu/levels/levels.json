  "start_color": "#1e3a8a",
  "levels": [
	{ "mode": "add", "equation": "? + ? = 3",  "grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "start": [1, 3] },
	{ "mode": "add", "equation": "? + ? = 10", "grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "start": [1, 3] },
	{ "mode": "sub", "equation": "? - ? = 2",  "grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "start": [1, 3] },
	{ "mode": "sub", "equation": "? - ? = ?",  "grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "start": [1, 3] },
	{ "mode": "add", "equation": "? + ? = ?",  "grid": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "start": [1, 3] }
  ]
